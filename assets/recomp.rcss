/* Slider knob (letter I) in front of the bar, whose image is created after it. */
.winks-knob {
    z-index: 1;
}

/* Selected choice: yellow like the game's menu titles (env color FFFF00). */
.winks-checked img {
    image-color: #FFFF00;
}
