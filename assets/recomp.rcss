/*
  In order for rml to parse the base style sheet and combine with this one, any style needs to at least be present.
  If you add styles to this file later, you can clear the current contents of this file.
*/
.rml-needs-something-in-this-file {}

/* 40 Winks lettering in the settings (src/main/main.cpp, game_text_rml): 16 swing cycles (+-12 degrees, sine,
   one full period per animation), each starting at a phase 22.5 degrees further, so letters can swing out of step
   without animation delays (RmlUi clamps animation steps to 0.1 s and loses negative delays). */
@keyframes winks-swing-0 {
    0% { transform: rotate(0.00deg); }
    6.25% { transform: rotate(4.59deg); }
    12.5% { transform: rotate(8.49deg); }
    18.75% { transform: rotate(11.09deg); }
    25% { transform: rotate(12.00deg); }
    31.25% { transform: rotate(11.09deg); }
    37.5% { transform: rotate(8.49deg); }
    43.75% { transform: rotate(4.59deg); }
    50% { transform: rotate(0.00deg); }
    56.25% { transform: rotate(-4.59deg); }
    62.5% { transform: rotate(-8.49deg); }
    68.75% { transform: rotate(-11.09deg); }
    75% { transform: rotate(-12.00deg); }
    81.25% { transform: rotate(-11.09deg); }
    87.5% { transform: rotate(-8.49deg); }
    93.75% { transform: rotate(-4.59deg); }
    100% { transform: rotate(-0.00deg); }
}
@keyframes winks-swing-1 {
    0% { transform: rotate(4.59deg); }
